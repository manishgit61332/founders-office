// Public client configuration only. Copy values into an untracked local
// xcconfig or inject them from protected release CI variables.
FOUNDER_OFFICE_SUPABASE_URL = https:/$()/PROJECT_REF.supabase.co
FOUNDER_OFFICE_SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
// Provisional only. Production should use the reviewed HTTPS universal-link
// callback described in README.md.
FOUNDER_OFFICE_AUTH_CALLBACK_SCHEME = founders-office
