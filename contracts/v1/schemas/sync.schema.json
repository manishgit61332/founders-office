{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.founders-office.test/v1/schemas/sync.schema.json",
  "title": "Founder’s Office sync protocol v1",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "Cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "EntityType": {
      "enum": ["workspace", "move", "appearance", "primaryGoal", "milestone", "asset"]
    },
    "IdentityProvider": {
      "enum": ["google", "apple"]
    },
    "FieldName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
    },
    "FieldClocks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/FieldName" },
      "additionalProperties": { "$ref": "#/$defs/Timestamp" }
    },
    "MutationAction": {
      "enum": ["upsert", "delete"]
    },
    "AuthSessionIDs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "workspaceId", "deviceId", "identityProvider"],
      "properties": {
        "accountId": { "$ref": "#/$defs/UUID" },
        "workspaceId": { "$ref": "#/$defs/UUID" },
        "deviceId": { "$ref": "#/$defs/UUID" },
        "identityProvider": { "$ref": "#/$defs/IdentityProvider" }
      }
    },
    "SyncOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "operationId",
        "entityType",
        "entityId",
        "action",
        "baseRevision",
        "changedFields",
        "fieldClocks",
        "occurredAt"
      ],
      "properties": {
        "contractVersion": { "const": 1 },
        "operationId": { "$ref": "#/$defs/UUID" },
        "entityType": { "$ref": "#/$defs/EntityType" },
        "entityId": { "$ref": "#/$defs/UUID" },
        "action": { "$ref": "#/$defs/MutationAction" },
        "baseRevision": { "$ref": "#/$defs/Revision" },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FieldName" }
        },
        "fieldClocks": { "$ref": "#/$defs/FieldClocks" },
        "payload": { "type": ["object", "null"] },
        "occurredAt": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "entityType": { "const": "workspace" } } },
          "then": {
            "properties": {
              "changedFields": { "items": { "enum": ["name"] } },
              "fieldClocks": { "propertyNames": { "enum": ["name"] } },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 120 }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "move" } } },
          "then": {
            "properties": {
              "changedFields": {
                "items": {
                  "enum": [
                    "title", "details", "status", "previousStatus", "priority", "dueOn",
                    "completedAt", "deletedAt", "source", "createdAt"
                  ]
                }
              },
              "fieldClocks": {
                "propertyNames": {
                  "enum": [
                    "title", "details", "status", "previousStatus", "priority", "dueOn",
                    "completedAt", "deletedAt", "source", "createdAt"
                  ]
                }
              },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                      "details": { "type": "string", "maxLength": 20000 },
                      "status": { "enum": ["doing", "next", "blocked", "done"] },
                      "previousStatus": {
                        "oneOf": [
                          { "enum": ["doing", "next", "blocked", "done"] },
                          { "type": "null" }
                        ]
                      },
                      "priority": { "enum": ["P0", "P1", "P2", "P3"] },
                      "dueOn": {
                        "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
                      },
                      "completedAt": {
                        "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
                      },
                      "deletedAt": {
                        "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
                      },
                      "source": { "type": "string", "minLength": 1, "maxLength": 64 },
                      "createdAt": { "$ref": "#/$defs/Timestamp" }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "appearance" } } },
          "then": {
            "properties": {
              "changedFields": { "items": { "enum": ["schemaVersion", "preferences", "deletedAt"] } },
              "fieldClocks": { "propertyNames": { "enum": ["schemaVersion", "preferences", "deletedAt"] } },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
                      "preferences": { "type": "object" },
                      "deletedAt": {
                        "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
                      }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "primaryGoal" } } },
          "then": {
            "properties": {
              "changedFields": {
                "items": {
                  "enum": ["title", "metric", "currentValue", "targetValue", "unit", "dueOn", "deletedAt"]
                }
              },
              "fieldClocks": {
                "propertyNames": {
                  "enum": ["title", "metric", "currentValue", "targetValue", "unit", "dueOn", "deletedAt"]
                }
              },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                      "metric": { "type": "string", "maxLength": 120 },
                      "currentValue": {
                        "oneOf": [
                          { "$ref": "records.schema.json#/$defs/NonnegativeDecimal30Scale8" },
                          { "type": "null" }
                        ]
                      },
                      "targetValue": {
                        "oneOf": [
                          { "$ref": "records.schema.json#/$defs/NonnegativeDecimal30Scale8" },
                          { "type": "null" }
                        ]
                      },
                      "unit": { "enum": ["usd", "inr", "number", "percent"] },
                      "dueOn": { "type": "string", "format": "date" },
                      "deletedAt": {
                        "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
                      }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "milestone" } } },
          "then": {
            "properties": {
              "changedFields": {
                "items": { "enum": ["title", "dueAt", "deletedAt", "createdAt"] }
              },
              "fieldClocks": {
                "propertyNames": { "enum": ["title", "dueAt", "deletedAt", "createdAt"] }
              },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                      "dueAt": { "$ref": "#/$defs/Timestamp" },
                      "deletedAt": {
                        "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
                      },
                      "createdAt": { "$ref": "#/$defs/Timestamp" }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "asset" } } },
          "then": {
            "properties": {
              "changedFields": {
                "items": { "enum": ["kind", "storagePath", "contentType", "byteSize", "sha256", "deletedAt"] }
              },
              "fieldClocks": {
                "propertyNames": { "enum": ["kind", "storagePath", "contentType", "byteSize", "sha256", "deletedAt"] }
              },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "const": "visionImage" },
                      "storagePath": {
                        "type": "string",
                        "pattern": "^workspaces/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/vision-images/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.jpg$",
                        "description": "Must equal workspaces/{request workspaceId}/vision-images/{operation entityId}.jpg."
                      },
                      "contentType": { "const": "image/jpeg" },
                      "byteSize": { "type": "integer", "minimum": 1, "maximum": 5242880 },
                      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                      "deletedAt": {
                        "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
                      }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "upsert" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "type": "object" } } }
        },
        {
          "if": { "properties": { "action": { "const": "delete" } } },
          "then": {
            "properties": {
              "changedFields": { "const": ["deletedAt"] },
              "fieldClocks": {
                "type": "object",
                "additionalProperties": false,
                "required": ["deletedAt"],
                "properties": { "deletedAt": { "$ref": "#/$defs/Timestamp" } }
              },
              "payload": { "type": "null" }
            }
          }
        }
      ]
    },
    "SyncConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "entityType",
        "entityId",
        "baseRevision",
        "currentRevision",
        "reason",
        "conflictingFields",
        "serverRecord"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/UUID" },
        "entityType": { "$ref": "#/$defs/EntityType" },
        "entityId": { "$ref": "#/$defs/UUID" },
        "baseRevision": { "$ref": "#/$defs/Revision" },
        "currentRevision": { "$ref": "#/$defs/Revision" },
        "reason": {
          "enum": ["revisionMismatch", "overlappingChanges", "fieldClockLost", "missingRecord"]
        },
        "conflictingFields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FieldName" }
        },
        "serverRecord": {
          "oneOf": [
            { "$ref": "records.schema.json#/$defs/Record" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": { "enum": ["overlappingChanges", "fieldClockLost"] }
            }
          },
          "then": {
            "properties": { "conflictingFields": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "workspace" } } },
          "then": {
            "properties": {
              "conflictingFields": { "items": { "enum": ["name"] } },
              "serverRecord": {
                "oneOf": [{ "$ref": "records.schema.json#/$defs/WorkspaceRecord" }, { "type": "null" }]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "move" } } },
          "then": {
            "properties": {
              "conflictingFields": {
                "items": {
                  "enum": ["title", "details", "status", "previousStatus", "priority", "dueOn", "completedAt", "deletedAt", "source", "createdAt"]
                }
              },
              "serverRecord": {
                "oneOf": [{ "$ref": "records.schema.json#/$defs/MoveRecord" }, { "type": "null" }]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "appearance" } } },
          "then": {
            "properties": {
              "conflictingFields": { "items": { "enum": ["schemaVersion", "preferences", "deletedAt"] } },
              "serverRecord": {
                "oneOf": [{ "$ref": "records.schema.json#/$defs/AppearanceRecord" }, { "type": "null" }]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "primaryGoal" } } },
          "then": {
            "properties": {
              "conflictingFields": { "items": { "enum": ["title", "metric", "currentValue", "targetValue", "unit", "dueOn", "deletedAt"] } },
              "serverRecord": {
                "oneOf": [{ "$ref": "records.schema.json#/$defs/PrimaryGoalRecord" }, { "type": "null" }]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "milestone" } } },
          "then": {
            "properties": {
              "conflictingFields": { "items": { "enum": ["title", "dueAt", "deletedAt", "createdAt"] } },
              "serverRecord": {
                "oneOf": [{ "$ref": "records.schema.json#/$defs/MilestoneRecord" }, { "type": "null" }]
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "asset" } } },
          "then": {
            "properties": {
              "conflictingFields": { "items": { "enum": ["kind", "storagePath", "contentType", "byteSize", "sha256", "deletedAt"] } },
              "serverRecord": {
                "oneOf": [{ "$ref": "records.schema.json#/$defs/AssetRecord" }, { "type": "null" }]
              }
            }
          }
        }
      ]
    },
    "OperationResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "status", "revision", "cursor"],
          "properties": {
            "operationId": { "$ref": "#/$defs/UUID" },
            "status": { "const": "accepted" },
            "revision": { "$ref": "#/$defs/Revision" },
            "cursor": { "$ref": "#/$defs/Cursor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "status", "revision", "cursor"],
          "properties": {
            "operationId": { "$ref": "#/$defs/UUID" },
            "status": { "const": "duplicate" },
            "revision": { "$ref": "#/$defs/Revision" },
            "cursor": { "$ref": "#/$defs/Cursor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "status", "conflict"],
          "properties": {
            "operationId": { "$ref": "#/$defs/UUID" },
            "status": { "const": "conflict" },
            "conflict": { "$ref": "#/$defs/SyncConflict" }
          }
        }
      ]
    },
    "SyncChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "operationId",
        "entityType",
        "entityId",
        "action",
        "revision",
        "changedFields",
        "changedAt",
        "record"
      ],
      "properties": {
        "cursor": { "$ref": "#/$defs/Cursor" },
        "operationId": { "$ref": "#/$defs/UUID" },
        "entityType": { "$ref": "#/$defs/EntityType" },
        "entityId": { "$ref": "#/$defs/UUID" },
        "action": { "$ref": "#/$defs/MutationAction" },
        "revision": { "$ref": "#/$defs/Revision" },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FieldName" }
        },
        "changedAt": { "$ref": "#/$defs/Timestamp" },
        "record": {
          "oneOf": [
            { "$ref": "records.schema.json#/$defs/Record" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "entityType": { "const": "workspace" } } },
          "then": {
            "properties": {
              "changedFields": { "items": { "enum": ["name"] } },
              "record": { "$ref": "records.schema.json#/$defs/WorkspaceRecord" }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "move" } } },
          "then": {
            "properties": {
              "changedFields": {
                "items": { "enum": ["title", "details", "status", "previousStatus", "priority", "dueOn", "completedAt", "deletedAt", "source", "createdAt"] }
              },
              "record": { "$ref": "records.schema.json#/$defs/MoveRecord" }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "appearance" } } },
          "then": {
            "properties": {
              "changedFields": { "items": { "enum": ["schemaVersion", "preferences", "deletedAt"] } },
              "record": { "$ref": "records.schema.json#/$defs/AppearanceRecord" }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "primaryGoal" } } },
          "then": {
            "properties": {
              "changedFields": { "items": { "enum": ["title", "metric", "currentValue", "targetValue", "unit", "dueOn", "deletedAt"] } },
              "record": { "$ref": "records.schema.json#/$defs/PrimaryGoalRecord" }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "milestone" } } },
          "then": {
            "properties": {
              "changedFields": { "items": { "enum": ["title", "dueAt", "deletedAt", "createdAt"] } },
              "record": { "$ref": "records.schema.json#/$defs/MilestoneRecord" }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "asset" } } },
          "then": {
            "properties": {
              "changedFields": { "items": { "enum": ["kind", "storagePath", "contentType", "byteSize", "sha256", "deletedAt"] } },
              "record": { "$ref": "records.schema.json#/$defs/AssetRecord" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "delete" } } },
          "then": {
            "properties": {
              "changedFields": { "const": ["deletedAt"] },
              "record": {
                "type": "object",
                "required": ["deletedAt"],
                "properties": { "deletedAt": { "$ref": "#/$defs/Timestamp" } }
              }
            }
          }
        }
      ]
    },
    "ActivityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "accountId", "kind", "occurredAt", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "workspaceId": { "$ref": "#/$defs/UUID" },
        "accountId": { "$ref": "#/$defs/UUID" },
        "deviceId": {
          "oneOf": [{ "$ref": "#/$defs/UUID" }, { "type": "null" }]
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
          "maxLength": 100
        },
        "entityType": {
          "oneOf": [{ "$ref": "#/$defs/EntityType" }, { "type": "null" }]
        },
        "entityId": {
          "oneOf": [{ "$ref": "#/$defs/UUID" }, { "type": "null" }]
        },
        "occurredAt": { "$ref": "#/$defs/Timestamp" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "AssetObjectManifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "storagePath", "contentType", "byteSize", "sha256", "deletedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "storagePath": {
          "type": "string",
          "pattern": "^workspaces/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/vision-images/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.jpg$",
          "description": "Must equal workspaces/{export workspace.id}/vision-images/{manifest id}.jpg."
        },
        "contentType": { "const": "image/jpeg" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "deletedAt": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        }
      }
    },
    "AssetTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "manifest"],
      "properties": {
        "state": {
          "enum": ["notRequired", "requiresPrivateStorageAdapter", "verified"]
        },
        "manifest": {
          "type": "array",
          "items": { "$ref": "#/$defs/AssetObjectManifestItem" }
        }
      }
    },
    "BootstrapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_device_id"],
      "properties": {
        "p_device_id": { "$ref": "#/$defs/UUID" },
        "p_local_workspace_id": {
          "oneOf": [{ "$ref": "#/$defs/UUID" }, { "type": "null" }]
        },
        "p_workspace_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "p_display_name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "NFC-normalized; trim Unicode whitespace/newlines; at most 80 Unicode scalars and 320 UTF-8 bytes; must contain a letter, number, or symbol; controls, line/paragraph separators, bidi controls, and BOM are forbidden."
            },
            { "type": "null" }
          ]
        }
      }
    },
    "BootstrapResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "session",
        "profile",
        "workspace",
        "startingCursor",
        "latestCursor"
      ],
      "properties": {
        "contractVersion": { "const": 1 },
        "session": { "$ref": "#/$defs/AuthSessionIDs" },
        "profile": { "$ref": "records.schema.json#/$defs/ProfileRecord" },
        "workspace": { "$ref": "records.schema.json#/$defs/WorkspaceRecord" },
        "startingCursor": { "const": 0 },
        "latestCursor": { "$ref": "#/$defs/Cursor" }
      }
    },
    "PushRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_workspace_id", "p_device_id", "p_operations"],
      "properties": {
        "p_workspace_id": { "$ref": "#/$defs/UUID" },
        "p_device_id": { "$ref": "#/$defs/UUID" },
        "p_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/SyncOperation" }
        }
      }
    },
    "PushResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "workspaceId", "latestCursor", "results"],
      "properties": {
        "contractVersion": { "const": 1 },
        "workspaceId": { "$ref": "#/$defs/UUID" },
        "latestCursor": { "$ref": "#/$defs/Cursor" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/OperationResult" }
        }
      }
    },
    "PullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_workspace_id", "p_device_id", "p_cursor"],
      "properties": {
        "p_workspace_id": { "$ref": "#/$defs/UUID" },
        "p_device_id": { "$ref": "#/$defs/UUID" },
        "p_cursor": { "$ref": "#/$defs/Cursor" },
        "p_limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 200 }
      }
    },
    "PullResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "workspaceId",
        "fromCursor",
        "nextCursor",
        "latestCursor",
        "hasMore",
        "changes"
      ],
      "properties": {
        "contractVersion": { "const": 1 },
        "workspaceId": { "$ref": "#/$defs/UUID" },
        "fromCursor": { "$ref": "#/$defs/Cursor" },
        "nextCursor": { "$ref": "#/$defs/Cursor" },
        "latestCursor": { "$ref": "#/$defs/Cursor" },
        "hasMore": { "type": "boolean" },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/SyncChange" }
        }
      }
    },
    "ExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_workspace_id"],
      "properties": {
        "p_workspace_id": { "$ref": "#/$defs/UUID" }
      }
    },
    "ExportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "exportedAt",
        "workspace",
        "moves",
        "appearance",
        "primaryGoals",
        "milestones",
        "assets",
        "assetTransfer",
        "activityEvents"
      ],
      "properties": {
        "contractVersion": { "const": 1 },
        "exportedAt": { "$ref": "#/$defs/Timestamp" },
        "workspace": { "$ref": "records.schema.json#/$defs/WorkspaceRecord" },
        "moves": {
          "type": "array",
          "items": { "$ref": "records.schema.json#/$defs/MoveRecord" }
        },
        "appearance": {
          "type": "array",
          "items": { "$ref": "records.schema.json#/$defs/AppearanceRecord" }
        },
        "primaryGoals": {
          "type": "array",
          "items": { "$ref": "records.schema.json#/$defs/PrimaryGoalRecord" }
        },
        "milestones": {
          "type": "array",
          "items": { "$ref": "records.schema.json#/$defs/MilestoneRecord" }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "records.schema.json#/$defs/AssetRecord" }
        },
        "assetTransfer": { "$ref": "#/$defs/AssetTransfer" },
        "activityEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActivityEvent" }
        }
      }
    },
    "EraseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_workspace_id", "p_confirm_workspace_id"],
      "properties": {
        "p_workspace_id": { "$ref": "#/$defs/UUID" },
        "p_confirm_workspace_id": { "$ref": "#/$defs/UUID" }
      }
    },
    "EraseResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "workspaceId",
        "erasedAt",
        "assetObjectCount",
        "assetCleanupState"
      ],
      "properties": {
        "contractVersion": { "const": 1 },
        "workspaceId": { "$ref": "#/$defs/UUID" },
        "erasedAt": { "$ref": "#/$defs/Timestamp" },
        "assetObjectCount": { "type": "integer", "minimum": 0 },
        "assetCleanupState": { "enum": ["notRequired", "verified"] }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
