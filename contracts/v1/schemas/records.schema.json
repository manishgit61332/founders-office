{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.founders-office.test/v1/schemas/records.schema.json",
  "title": "Founder’s Office durable records v1",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "FieldClocks": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
      },
      "additionalProperties": { "$ref": "#/$defs/Timestamp" }
    },
    "ProfileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "identityProvider"],
      "properties": {
        "accountId": { "$ref": "#/$defs/UUID" },
        "identityProvider": { "enum": ["google", "apple"] },
        "displayName": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 120 },
            { "type": "null" }
          ]
        }
      }
    },
    "WorkspaceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "revision", "fieldClocks", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "revision": { "$ref": "#/$defs/Revision" },
        "fieldClocks": { "$ref": "#/$defs/FieldClocks" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MoveRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "details",
        "status",
        "priority",
        "source",
        "revision",
        "fieldClocks",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "details": { "type": "string", "maxLength": 20000 },
        "status": { "enum": ["doing", "next", "blocked", "done"] },
        "previousStatus": {
          "oneOf": [
            { "enum": ["doing", "next", "blocked", "done"] },
            { "type": "null" }
          ]
        },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "dueOn": {
          "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        },
        "completedAt": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        },
        "deletedAt": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 64 },
        "revision": { "$ref": "#/$defs/Revision" },
        "fieldClocks": { "$ref": "#/$defs/FieldClocks" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AppearanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "preferences",
        "revision",
        "fieldClocks",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "preferences": { "type": "object" },
        "deletedAt": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        },
        "revision": { "$ref": "#/$defs/Revision" },
        "fieldClocks": { "$ref": "#/$defs/FieldClocks" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PrimaryGoalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "metric",
        "unit",
        "dueOn",
        "revision",
        "fieldClocks",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "metric": { "type": "string", "maxLength": 120 },
        "currentValue": { "type": ["number", "null"] },
        "targetValue": { "type": ["number", "null"] },
        "unit": { "enum": ["usd", "inr", "number", "percent"] },
        "dueOn": { "type": "string", "format": "date" },
        "deletedAt": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        },
        "revision": { "$ref": "#/$defs/Revision" },
        "fieldClocks": { "$ref": "#/$defs/FieldClocks" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AssetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "storagePath",
        "contentType",
        "byteSize",
        "sha256",
        "revision",
        "fieldClocks",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/UUID" },
        "kind": { "enum": ["visionImage"] },
        "storagePath": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 255 },
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 52428800 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "deletedAt": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        },
        "revision": { "$ref": "#/$defs/Revision" },
        "fieldClocks": { "$ref": "#/$defs/FieldClocks" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Record": {
      "oneOf": [
        { "$ref": "#/$defs/WorkspaceRecord" },
        { "$ref": "#/$defs/MoveRecord" },
        { "$ref": "#/$defs/AppearanceRecord" },
        { "$ref": "#/$defs/PrimaryGoalRecord" },
        { "$ref": "#/$defs/AssetRecord" }
      ]
    }
  }
}
