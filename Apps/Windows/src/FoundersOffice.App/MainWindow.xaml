<Window
    x:Class="FoundersOffice.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Founder's Office">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="20,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="14"
                FontWeight="SemiBold"
                Text="FOUNDER'S OFFICE · WINDOWS PREVIEW" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Click="HideButton_Click" ToolTipService.ToolTip="Hide to system tray">
                    <FontIcon Glyph="&#xE921;" />
                </Button>
                <Button Click="ExitButton_Click" ToolTipService.ToolTip="Exit">
                    <FontIcon Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,12,24,24">
            <Grid MaxWidth="760">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="38"
                        FontWeight="SemiBold"
                        Text="What can we do?" />
                    <TextBlock
                        x:Name="WorkspaceStatusText"
                        FontSize="16"
                        Opacity="0.84"
                        Text="Opening your private workspace…" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="0,24,0,0"
                    Padding="20"
                    Background="{ThemeResource SurfaceCardBrush}"
                    BorderBrush="{ThemeResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Foreground="{ThemeResource AccentBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="NEXT MOVE" />
                        <TextBlock
                            x:Name="NextMoveTitleText"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Nothing queued yet" />
                        <TextBlock
                            x:Name="NextMoveDetailsText"
                            FontSize="16"
                            Opacity="0.88"
                            Text="Add one clear Move below."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="18"
                    Background="{ThemeResource SurfaceCardBrush}"
                    BorderBrush="{ThemeResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Quick add" />
                        <TextBox
                            x:Name="MoveTitleInput"
                            AutomationProperties.Name="Move title"
                            Header="Title"
                            MaxLength="500"
                            PlaceholderText="The next concrete thing" />
                        <TextBox
                            x:Name="MoveDetailsInput"
                            AutomationProperties.Name="Move description"
                            AcceptsReturn="True"
                            Header="Description"
                            MaxLength="20000"
                            MinHeight="74"
                            PlaceholderText="Optional context"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="AddMoveButton"
                                Click="AddMoveButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                Add Move
                            </Button>
                            <ProgressRing x:Name="BusyIndicator" Width="22" Height="22" IsActive="False" />
                        </StackPanel>
                        <InfoBar
                            x:Name="OperationInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Error"
                            Title="Couldn’t save this Move"
                            Message="Your existing workspace was not changed. Please try again." />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
