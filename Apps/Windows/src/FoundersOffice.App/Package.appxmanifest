<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <!-- Development-only identity. Freeze the public package identity before beta signing. -->
  <Identity
    Name="FounderOffice.Windows.Development"
    Publisher="CN=FounderOfficeDevelopment"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>Founder's Office</DisplayName>
    <PublisherDisplayName>Founder Office Development</PublisherDisplayName>
    <Logo>Assets\AppIcon.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.22621.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Founder's Office"
        Description="A calm surface for the next Move."
        BackgroundColor="transparent"
        Square44x44Logo="Assets\AppIcon.png"
        Square150x150Logo="Assets\AppIcon.png">
        <uap:DefaultTile Wide310x150Logo="Assets\AppIcon.png" />
        <uap:SplashScreen Image="Assets\AppIcon.png" BackgroundColor="#17181A" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="FoundersOffice.App.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FounderOfficeStartup" Enabled="false" DisplayName="Founder's Office" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
