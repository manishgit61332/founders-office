<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OpenLoopsApplication"
        android:allowBackup="false"
        android:label="Founder's Office"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoundersOffice">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openloops" android:host="move" />
                <data android:scheme="openloops" android:host="calendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:path="/callback"
                    android:scheme="com.foundersoffice.openloops" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.OpenLoopsSmallWidgetReceiver"
            android:exported="true"
            android:label="Founder's Office">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/open_loops_small_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.OpenLoopsMediumWidgetReceiver"
            android:exported="true"
            android:label="Founder's Office">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/open_loops_medium_widget_info" />
        </receiver>
    </application>
</manifest>
