<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Founder's Office</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Founder's Office</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.11.0</string>
    <key>CFBundleVersion</key>
    <string>14</string>
    <key>FounderOfficeCloudEnabled</key>
    <true/>
    <!-- Development value. The release script replaces this with the final,
         entitlement-matched production container before archiving. -->
    <key>FounderOfficeCloudContainerIdentifier</key>
    <string>iCloud.com.manish.foundersoffice</string>
    <key>FounderOfficeUpdateFeedURL</key>
    <string>$(FOUNDER_OFFICE_UPDATE_FEED_URL)</string>
    <key>FounderOfficeUpdateChannel</key>
    <string>$(FOUNDER_OFFICE_UPDATE_CHANNEL)</string>
    <key>FounderOfficeUpdatePublicKey</key>
    <string>$(FOUNDER_OFFICE_UPDATE_PUBLIC_KEY)</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>LSUIElement</key>
    <true/>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Founder's Office shows upcoming events and lets you add events to the calendars already enabled on this Mac.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
