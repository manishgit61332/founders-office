<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- This entitlement remains a physical-device/provisioning gate. The
         extension fails closed to a signed-out placeholder when unavailable. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.manish.foundersoffice</string>
    </array>
</dict>
</plist>
